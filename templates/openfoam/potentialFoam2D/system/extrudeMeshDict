FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    location "system";
    object extrudeMeshDict;
}

constructFrom       patch;
sourceCase          ".";
sourcePatches       (front);
exposedPatchName    back;
flipNormals         false;

extrudeModel        linearNormal;

nLayers             1;
expansionRatio      1.0;

linearNormalCoeffs
{
    thickness       0.01;
}

mergeFaces          false;
